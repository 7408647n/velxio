{
  "_comment": "Bus vectors for the Bosch BMP280, shared by the tab model (frontend/src/simulation/I2CBusManager.ts, vitest) and the worker's copy (backend/app/services/esp32_i2c_slaves.py, pytest). The format is in README.md next to this file. Register facts are from the datasheet BST-BMP280-DS001 rev 1.26; driver traces name the source they were read from.",
  "format": 1,
  "device": "bmp280",
  "address": "76",
  "rules": {
    "power_on": {
      "D0": "58",
      "F7": "80",
      "FA": "80"
    },
    "writable": [
      "F4",
      "F5"
    ],
    "reset": {
      "E0": "B6"
    },
    "status": {
      "F3": "08"
    },
    "mode": {
      "register": "F4",
      "mask": "03",
      "sleep": "00",
      "normal": "03"
    },
    "sample": [
      "F7",
      "FC"
    ]
  },
  "inputs": {
    "temperature": 24,
    "pressure": 1013.25
  },
  "vectors": [
    {
      "name": "power-on: the id reads 0x58, the control registers and status 0x00, the data registers their reset value, the calibration is there",
      "spec": "BMP280 datasheet 4.2, table 18: reset state of every register",
      "steps": [
        {"op": "read", "reg": "D0", "n": 1, "expect": "58"},
        {"op": "read", "reg": "E0", "n": 1, "expect": "00"},
        {"op": "read", "reg": "F2", "n": 4, "expect": "00*4"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "80 00 00 80 00 00"},
        {"op": "read", "reg": "00", "n": 256, "expect": "00*136 70 6B 43 67 18 FC 7D 8E 43 D6 D0 0B 27 0B 8C 00 F9 FF 8C 3C F8 C6 70 17 00*48 58 00*38 80 00 00 80 00*5"},
        {"op": "dump", "at": "F2", "expect": "00*5 80 00 00 80 00*4"}
      ]
    },
    {
      "name": "sleep mode: nothing is measured, so the data registers keep their reset value whatever the panel says",
      "spec": "3.6.1: in sleep mode no measurements are performed; BMP280 datasheet 4.2, table 18: reset state 0x80 0x00 0x00",
      "steps": [
        {"op": "read", "reg": "F7", "n": 6, "expect": "80 00 00 80 00 00"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "80 00 00 80 00 00"},
        {"op": "dump", "at": "F7", "expect": "80 00 00 80 00 00"},
        {"op": "write", "data": "F4 24"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "80 00 00 80 00 00"}
      ]
    },
    {
      "name": "normal mode: every read finds a measurement of what the panel says now",
      "spec": "3.6.3: the last measurement results can be obtained from the data registers without further write accesses",
      "steps": [
        {"op": "write", "data": "F4 27"},
        {"op": "read", "reg": "F4", "n": 1, "expect": "27"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "64 2A 90 7E 14 80"},
        {"op": "inputs", "values": {"temperature": 30}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "65 79 A0 82 C2 00"},
        {"op": "inputs", "values": {"pressure": 900}},
        {"op": "read", "reg": "FA", "n": 3, "expect": "82 C2 00"},
        {"op": "read", "reg": "F7", "n": 3, "expect": "75 65 40"},
        {"op": "dump", "at": "F7", "expect": "75 65 40 82 C2 00"}
      ]
    },
    {
      "name": "forced mode: one measurement of what the panel says at the write, then the mode bits read 00 and the data stays",
      "spec": "3.6.2: a single measurement is performed, when it is finished the sensor returns to sleep mode; 3.6, table 10: 01 and 10 are forced mode",
      "steps": [
        {"op": "write", "data": "F4 25"},
        {"op": "read", "reg": "F4", "n": 1, "expect": "24"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "64 2A 90 7E 14 80"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "64 2A 90 7E 14 80"},
        {"op": "dump", "at": "F7", "expect": "64 2A 90 7E 14 80"},
        {"op": "write", "data": "F4 26"},
        {"op": "read", "reg": "F4", "n": 1, "expect": "24"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"}
      ]
    },
    {
      "name": "status: measuring reads 1 on the first read after a mode write that starts a conversion and 0 on the next, im_update is never seen",
      "spec": "4.3.3: measuring is set whenever a conversion is running and back to 0 when the results have been transferred",
      "steps": [
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 25"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "08"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 27"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "08"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 24"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 27"},
        {"op": "write", "data": "F4 24"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 25"},
        {"op": "read", "reg": "F4", "n": 2, "expect": "24 00"},
        {"op": "read", "reg": "D0", "n": 1, "expect": "58"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "08"},
        {"op": "write", "data": "F4 25"},
        {"op": "read", "reg": "F2", "n": 3, "expect": "00 08 24"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 25"},
        {"op": "dump", "at": "F3", "expect": "00"}
      ]
    },
    {
      "name": "soft reset: 0xB6 written to 0xE0 puts the control and data registers back to their power-on values and reads back 0x00, what the panel set stays",
      "spec": "4.3.2: the device is reset using the complete power-on-reset procedure, the readout value is always 0x00",
      "steps": [
        {"op": "write", "data": "F5 90"},
        {"op": "write", "data": "F4 57"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"},
        {"op": "write", "data": "E0 B6"},
        {"op": "read", "reg": "E0", "n": 1, "expect": "00"},
        {"op": "read", "reg": "F2", "n": 4, "expect": "00*4"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "80 00 00 80 00 00"},
        {"op": "read", "reg": "D0", "n": 1, "expect": "58"},
        {"op": "read", "reg": "88", "n": 24, "expect": "70 6B 43 67 18 FC 7D 8E 43 D6 D0 0B 27 0B 8C 00 F9 FF 8C 3C F8 C6 70 17"},
        {"op": "dump", "at": "F2", "expect": "00*5 80 00 00 80 00*4"},
        {"op": "write", "data": "F4 27"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"}
      ]
    },
    {
      "name": "soft reset: any other word written to 0xE0 does nothing and is not kept",
      "spec": "4.3.2: writing other values than 0xB6 has no effect",
      "steps": [
        {"op": "write", "data": "F5 90"},
        {"op": "write", "data": "F4 27"},
        {"op": "write", "data": "E0 00"},
        {"op": "write", "data": "E0 B5"},
        {"op": "write", "data": "E0 B7"},
        {"op": "write", "data": "E0 6B"},
        {"op": "write", "data": "E0 FF"},
        {"op": "read", "reg": "E0", "n": 1, "expect": "00"},
        {"op": "read", "reg": "F4", "n": 2, "expect": "27 90"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "64 2A 90 7E 14 80"}
      ]
    },
    {
      "name": "normal mode left for sleep mode: the data registers keep the last measurement",
      "spec": "3.6.1: in sleep mode no measurements are performed; 3.10: the data registers are updated at the end of a measurement",
      "steps": [
        {"op": "write", "data": "F4 27"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "write", "data": "F4 24"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"},
        {"op": "inputs", "values": {"temperature": 10, "pressure": 1000}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"},
        {"op": "read", "reg": "F3", "n": 2, "expect": "00 24"},
        {"op": "dump", "at": "F7", "expect": "75 65 40 82 C2 00"}
      ]
    },
    {
      "name": "a write is pairs of register address and register data: the address does not count up",
      "spec": "5.2.1: the master sends pairs of register addresses and register data; figure \"I2C multiple byte write (not auto-incremented)\"",
      "steps": [
        {"op": "write", "data": "F5 A0 F4 27"},
        {"op": "read", "reg": "F3", "n": 3, "expect": "08 27 A0"},
        {"op": "write", "data": "E0 B6"},
        {"op": "write", "data": "F4 27 10"},
        {"op": "read", "reg": "F4", "n": 2, "expect": "27 00"},
        {"op": "write", "data": "F4 57 F5"},
        {"op": "read", "reg": "F4", "n": 2, "expect": "57 00"}
      ]
    },
    {
      "name": "a read counts up from the last address written, across a STOP and past 0xFF",
      "spec": "5.2.2: the slave sends out data from auto-incremented register addresses",
      "steps": [
        {"op": "write", "data": "F4 27"},
        {"op": "get", "n": 2, "expect": "27 00"},
        {"op": "write", "data": "D0"},
        {"op": "get", "n": 1, "expect": "58"},
        {"op": "get", "n": 1, "expect": "00"},
        {"op": "write", "data": "F4 27 F5 90"},
        {"op": "get", "n": 1, "expect": "90"},
        {"op": "read", "reg": "FC", "n": 8, "expect": "80 00*7"},
        {"op": "read", "reg": "9E", "n": 4, "expect": "70 17 00 00"}
      ]
    },
    {
      "name": "a write to a read-only or reserved register changes nothing",
      "spec": "BMP280 datasheet 4.2, table 18: calibration data, id, status and data registers are read only",
      "steps": [
        {"op": "write", "data": "F4 27"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "write", "data": "88 AA"},
        {"op": "write", "data": "9F AA"},
        {"op": "write", "data": "D0 00"},
        {"op": "write", "data": "F3 FF"},
        {"op": "write", "data": "F7 12"},
        {"op": "write", "data": "FA 34"},
        {"op": "write", "data": "FC 56"},
        {"op": "write", "data": "00 77"},
        {"op": "write", "data": "F6 77"},
        {"op": "write", "data": "FF 77"},
        {"op": "write", "data": "A1 55"},
        {"op": "write", "data": "E1 55"},
        {"op": "read", "reg": "00", "n": 256, "expect": "00*136 70 6B 43 67 18 FC 7D 8E 43 D6 D0 0B 27 0B 8C 00 F9 FF 8C 3C F8 C6 70 17 00*48 58 00*34 08 27 00 00 75 65 40 82 C2 00*4"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"},
        {"op": "write", "data": "F2 05"},
        {"op": "read", "reg": "F2", "n": 1, "expect": "00"}
      ]
    },
    {
      "name": "a burst is one measurement: the panel moving while it is read does not mix two",
      "spec": "3.10: shadowing guarantees data consistency if all data registers are read in a single burst",
      "steps": [
        {"op": "write", "data": "F4 27"},
        {"op": "start", "rw": "w"},
        {"op": "send", "data": "F7"},
        {"op": "start", "rw": "r"},
        {"op": "recv", "n": 3, "expect": "64 2A 90"},
        {"op": "inputs", "values": {"temperature": 30, "pressure": 900}},
        {"op": "recv", "n": 3, "expect": "7E 14 80"},
        {"op": "stop"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "75 65 40 82 C2 00"}
      ]
    },
    {
      "name": "the raw values are those the compensation formulas turn back into the panel's, half a hundredth of a degree rounds up",
      "spec": "3.11.3 and 8.1: compensation formulas; the calibration is the block at 0x88",
      "steps": [
        {"op": "inputs", "values": {"temperature": 24.125}},
        {"op": "write", "data": "F4 27"},
        {"op": "read", "reg": "F7", "n": 6, "expect": "64 31 E0 7E 2E 80"},
        {"op": "inputs", "values": {"temperature": -12.345, "pressure": 300}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "C8 4D E0 61 E3 80"},
        {"op": "inputs", "values": {"temperature": 85, "pressure": 1100}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "65 4C B0 AD F0 80"},
        {"op": "inputs", "values": {"temperature": -40, "pressure": 1013.25}},
        {"op": "read", "reg": "F7", "n": 6, "expect": "54 DF E0 4C 96 00"}
      ]
    },
    {
      "name": "driver: Adafruit_BMP280 3.0.0 begin(0x76), the gallery setSampling(), readTemperature() and readPressure() before and after the panel moves",
      "spec": "Adafruit_BMP280.cpp begin(), readCoefficients(), setSampling(), read24(), getStatus(); Adafruit BusIO 1.17.4 Adafruit_I2CDevice::detected(), write(), write_then_read()",
      "driver": "adafruit-bmp280-arduino",
      "steps": [
        {"op": "write", "data": ""},
        {"op": "read", "reg": "D0", "n": 1, "expect": "58"},
        {"op": "read", "reg": "88", "n": 2, "expect": "70 6B"},
        {"op": "read", "reg": "8A", "n": 2, "expect": "43 67"},
        {"op": "read", "reg": "8C", "n": 2, "expect": "18 FC"},
        {"op": "read", "reg": "8E", "n": 2, "expect": "7D 8E"},
        {"op": "read", "reg": "90", "n": 2, "expect": "43 D6"},
        {"op": "read", "reg": "92", "n": 2, "expect": "D0 0B"},
        {"op": "read", "reg": "94", "n": 2, "expect": "27 0B"},
        {"op": "read", "reg": "96", "n": 2, "expect": "8C 00"},
        {"op": "read", "reg": "98", "n": 2, "expect": "F9 FF"},
        {"op": "read", "reg": "9A", "n": 2, "expect": "8C 3C"},
        {"op": "read", "reg": "9C", "n": 2, "expect": "F8 C6"},
        {"op": "read", "reg": "9E", "n": 2, "expect": "70 17"},
        {"op": "write", "data": "F5 00"},
        {"op": "write", "data": "F4 B7"},
        {"op": "write", "data": "F5 90"},
        {"op": "write", "data": "F4 57"},
        {"op": "read", "reg": "FA", "n": 3, "expect": "7E 14 80"},
        {"op": "read", "reg": "FA", "n": 3, "expect": "7E 14 80"},
        {"op": "read", "reg": "F7", "n": 3, "expect": "64 2A 90"},
        {"op": "inputs", "values": {"temperature": 31, "pressure": 990}},
        {"op": "read", "reg": "FA", "n": 3, "expect": "83 89 80"},
        {"op": "read", "reg": "FA", "n": 3, "expect": "83 89 80"},
        {"op": "read", "reg": "F7", "n": 3, "expect": "68 F3 00"},
        {"op": "read", "reg": "F3", "n": 1, "expect": "08"}
      ]
    },
    {
      "name": "driver: Adafruit_BMP280 3.0.0 in forced mode, takeForcedMeasurement() leaves its wait after one poll and reads the new measurement",
      "spec": "Adafruit_BMP280.cpp setSampling(), takeForcedMeasurement(): while (read8(BMP280_REGISTER_STATUS) & 0x08) delay(1)",
      "driver": "adafruit-bmp280-arduino",
      "steps": [
        {"op": "write", "data": ""},
        {"op": "read", "reg": "D0", "n": 1, "expect": "58"},
        {"op": "read", "reg": "88", "n": 2, "expect": "70 6B"},
        {"op": "read", "reg": "8A", "n": 2, "expect": "43 67"},
        {"op": "read", "reg": "8C", "n": 2, "expect": "18 FC"},
        {"op": "read", "reg": "8E", "n": 2, "expect": "7D 8E"},
